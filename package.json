{
  "name": "frameproof",
  "version": "0.1.0",
  "description": "Frame-level performance evidence for web apps, built to be used by coding agents.",
  "type": "module",
  "bin": {
    "frameproof": "bin/frameproof.mjs"
  },
  "files": [
    "bin",
    "src",
    "guide",
    "AGENTS.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "sim": "node test/sim/aa.mjs",
    "e2e": "node test/e2e/janky-shop.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Felichz/FrameProof.git"
  },
  "dependencies": {
    "puppeteer-core": "^25.16.0",
    "source-map-js": "^1.2.1"
  },
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "performance",
    "frames",
    "jank",
    "chrome",
    "trace",
    "agents",
    "cli"
  ]
}
